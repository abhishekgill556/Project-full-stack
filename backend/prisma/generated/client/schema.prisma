generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Service {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  price       Float
  image       String?
  category    String
  duration    Int
  bookings    Booking[]
  myServices  MyServices[]
}

model Stylist {
  id       Int    @id @default(autoincrement())
  category String
  service  String
  level    String
  price    Float
}

model Review {
  id        Int      @id @default(autoincrement())
  name      String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

model Blog {
  id            Int      @id @default(autoincrement())
  title         String
  description   String
  link          String
  createdAt     DateTime @default(now())
  authorClerkId String?
}

model ResourceCategory {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  summary   String?
  resources Resource[]
}

model Resource {
  id          Int              @id @default(autoincrement())
  title       String
  description String?
  url         String
  mediaType   String
  categoryId  Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  category    ResourceCategory @relation(fields: [categoryId], references: [id])
}

model Booking {
  id           Int      @id @default(autoincrement())
  customerName String
  serviceId    Int
  date         DateTime
  service      Service  @relation(fields: [serviceId], references: [id])
}

model User {
  id         String       @id @default(cuid())
  clerkId    String       @unique
  email      String?
  createdAt  DateTime     @default(now())
  MyServices MyServices[]
}

model MyServices {
  id        Int      @id @default(autoincrement())
  userId    String
  serviceId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [clerkId])
  service Service @relation(fields: [serviceId], references: [id])
}
