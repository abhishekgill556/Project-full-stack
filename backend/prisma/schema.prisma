generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Service {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  price       Float
  image       String?
  category    String
  duration    Int
  bookings    Booking[]
}

model Stylist {
  id       Int     @id @default(autoincrement())
  category String
  service  String
  level    String
  price    Float
}

model Review {
  id        Int      @id @default(autoincrement())
  name      String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

model Blog {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  createdAt DateTime @default(now())
}

model Booking {
  id           Int      @id @default(autoincrement())
  customerName String
  serviceId    Int
  date         DateTime
  service      Service  @relation(fields: [serviceId], references: [id])
}
